{
  "expo": {
    "name": "白泽Bayze",
    "slug": "lanwealth-cn-mobile",
    "version": "0.2.13",
    "orientation": "portrait",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": false
    },
    "icon": "./assets/icon.png",
    "scheme": "baize-cn",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0f0d"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cn.lanwealth.baize",
      "buildNumber": "39",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "用于语音输入:将你说的话识别为文字后发送,不用于其他用途。",
        "NSMicrophoneUsageDescription": "用于语音输入:按住说话时使用麦克风,不用时不会采集。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0754e2"
      },
      "package": "cn.lanwealth.baize",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/with-fmt-cxx17",
      "./plugins/with-scene-manifest",
      [
        "expo-share-intent",
        {
          "iosShareExtensionName": "Bayze Share",
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 5,
            "NSExtensionActivationSupportsFileWithMaxCount": 5
          },
          "androidIntentFilters": [
            "text/*",
            "image/*",
            "application/pdf",
            "application/msword",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "application/vnd.openxmlformats-officedocument.presentationml.presentation",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            "application/json",
            "application/xml",
            "application/octet-stream"
          ],
          "androidMultiIntentFilters": [
            "image/*",
            "text/*",
            "application/pdf",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "用于选择你指定的照片并添加到对话，不读取其他照片。",
          "cameraPermission": "用于按你的操作拍摄照片并添加到对话，不在后台拍摄。"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "用于语音输入：仅在你操作语音输入时使用麦克风。",
          "speechRecognitionPermission": "用于将你主动口述的内容转换为文字，供你确认后发送。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "a7d79a89-404c-4795-a6f6-76428b4b638b"
      },
      "router": {}
    }
  }
}
